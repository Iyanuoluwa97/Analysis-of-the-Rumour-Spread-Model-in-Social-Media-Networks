restart:  with(Physics):  Setup(mathematicalnotation = true):    #` PARAMETERS`     d := 10:  lambda := .8:  beta := .2:  delta := .6:  alpha := .3:  eta := .5:  xi := .5:  sigma := .3:  rho := .1:    Tau := 2:  N := 1000000:    M := 12:  hstep := .01:  delaysteps := round(Tau/hstep):  steps := 500:    #` STORAGE FOR DELAYED S COEFFICIENTS`    Sstored := table():      #` INITIAL CONDITIONS`    Icurrent := .999999:  Scurrent := .1e-5:  Hcurrent := 0:  Rcurrent := 0:     #` MAIN DTM METHOD-OF-STEPS LOOP`    for n from 0 to steps-1 do              #` INITIAL COEFFICIENTS FOR CURRENT INTERVAL`             F(0) := Icurrent:      S(0) := Scurrent:      H(0) := Hcurrent:      R(0) := Rcurrent:            #` DELAYED S COEFFICIENTS`          if n < delaysteps then            #` History: S(t) = 0.000001 for -Tau <= t <= 0`            for j from 0 to M do              if j = 0 then                  Sdelay(j) := .1e-5:              else                  Sdelay(j) := 0:              end if:          end do:        else            delayed_index := n - delaysteps:            for j from 0 to M do              Sdelay(j) := Sstored[delayed_index,j]:          end do:        end if:   #` EXTERNAL EVENT`      if n < delaysteps then      gamma_current := 0:  else      gamma_current := rho:  end if:           #` DTM RECURRENCE`            for k from 0 to M do            F(k+1) :=          1/(k+1)*          sum(              -(lambda+beta)*d*F(r)*S(k-r),              r=0..k          ):            S(k+1) :=          1/(k+1)*          (              sum(                  lambda*d*F(r)*S(k-r),                  r=0..k              )              - sum(                  alpha*d*S(r)*S(k-r),                  r=0..k              )              - sum(                  alpha*d*S(r)*H(k-r),                  r=0..k              )              - sum(                  alpha*d*S(r)*R(k-r),                  r=0..k              )              - delta*S(k)              + xi*H(k)              + sum(                  eta*d*H(r)*S(k-r),                  r=0..k              )              + sum(                  sigma*d*H(r)*Sdelay(k-r),                  r=0..k              ) + gamma_current*H(k)          ):            H(k+1) :=          1/(k+1)*          (              delta*S(k)              - xi*H(k)              - sum(                  eta*d*H(r)*S(k-r),                  r=0..k              )              - sum(                  sigma*d*H(r)*Sdelay(k-r),                  r=0..k              ) -gamma_current*H(k)          ):            R(k+1) :=          1/(k+1)*          (              sum(                  beta*d*F(r)*S(k-r),                  r=0..k              )              + sum(                  alpha*d*S(r)*S(k-r),                  r=0..k              )              + sum(                  alpha*d*S(r)*H(k-r),                  r=0..k              )              + sum(                  alpha*d*S(r)*R(k-r),                  r=0..k              )          ):        end do:              #` STORE CURRENT INTERVAL COEFFICIENTS`              for j from 0 to M do          Sstored[n,j] := eval(S(j)):      end do:              #` LOCAL DTM POLYNOMIALS`           f(u) := add(F(j)*u^j,j=0..M):      s(u) := add(S(j)*u^j,j=0..M):      hh(u) := add(H(j)*u^j,j=0..M):      rr(u) := add(R(j)*u^j,j=0..M):            #` ADVANCE BY 0.01 DAY`         Icurrent := eval(f(u),u=hstep):      Scurrent := eval(s(u),u=hstep):      Hcurrent := eval(hh(u),u=hstep):      Rcurrent := eval(rr(u),u=hstep):        #` SAVE RESULTS AT t = 1,2,3,4,5 DAYS`            if n+1 = 100 then          I1 := Icurrent:          S1 := Scurrent:          H1 := Hcurrent:          R1 := Rcurrent:      end if:        if n+1 = 200 then          I2 := Icurrent:          S2 := Scurrent:          H2 := Hcurrent:          R2 := Rcurrent:      end if:        if n+1 = 300 then          I3 := Icurrent:          S3 := Scurrent:          H3 := Hcurrent:          R3 := Rcurrent:      end if:        if n+1 = 400 then          I4 := Icurrent:          S4 := Scurrent:          H4 := Hcurrent:          R4 := Rcurrent:      end if:        if n+1 = 500 then          I5 := Icurrent:          S5 := Scurrent:          H5 := Hcurrent:          R5 := Rcurrent:      end if:    end do:    #` RESULTS`    [      I1,S1,H1,R1,      I2,S2,H2,R2,      I3,S3,H3,R3,      I4,S4,H4,R4,      I5,S5,H5,R5  ];
interface(version);
kernelopts(version);

